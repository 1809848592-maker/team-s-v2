# Copy outside the checkout to /etc/teams-platform/production.env, chmod 600.
# Use a DNS hostname only: no scheme, port, slash or wildcard.
PUBLIC_DOMAIN=teams.example.org
ACME_EMAIL=operator@example.org
# REQUIRED: replace with: python3 -c 'import secrets; print(secrets.token_hex(32))'
# URL-safe password only; do not use the development password or raw URL metacharacters.
POSTGRES_PASSWORD=
PLATFORM_IMAGE=teams-platform:production

# UUIDs of existing human accounts, comma separated. Empty means no platform admins.
PLATFORM_ADMIN_USER_IDS=
SESSION_TTL_SECONDS=1209600
UPLOAD_MAX_BYTES=104857600
BOTTLENECK_RETURN_DAYS=3

# Platform-wide key; never commit real values. Both processes use the same configuration.
DEEPSEEK_API_KEY=
LLM_ENABLE_LIVE_CALLS=false
LLM_PROJECT_DAILY_REVIEWS=20
LLM_PLATFORM_DAILY_REVIEWS=200
LLM_PLATFORM_DAILY_TOKENS=1000000
LLM_MAX_CALLS_PER_REVIEW=64
WORKER_POLL_SECONDS=2
REVIEW_JOB_TIMEOUT_SECONDS=300
REVIEW_JOB_LEASE_GRACE_SECONDS=5
REVIEW_JOB_MAX_ATTEMPTS=3
REVIEW_JOB_RETRY_DELAY_SECONDS=5
REVIEW_RETURN_LIMIT=3
