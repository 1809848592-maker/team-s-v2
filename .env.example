# 仅用于本地开发；部署时更换密码。不要将 .env 提交到 Git。
POSTGRES_DB=teams_dev
POSTGRES_USER=teams
POSTGRES_PASSWORD=teams_local_dev
WEB_PORT=8000
POSTGRES_PORT=5432
# 沿用 v1 的 14 天会话，HTTPS 部署时将 SESSION_COOKIE_SECURE 设为 true。
SESSION_TTL_SECONDS=1209600
SESSION_COOKIE_SECURE=false
# 注册后通过 /api/auth/me 获取不可变账号 ID；多个 ID 用逗号分隔。
PLATFORM_ADMIN_USER_IDS=
UPLOAD_MAX_BYTES=104857600
# 部署后添加服务器实际域名/Origin，以逗号分隔；保留MCP的Host/Origin校验。
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
# 平台统一配置的模型Key；真实值仅填写platform/.env，不提交Git。
DEEPSEEK_API_KEY=
